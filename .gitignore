# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/
conda-env/

# Data & checkpoints (never commit large binaries)
data/raw_covers/
data/processed/
data/cover_manifest.json
data/download_failures.json
*.pth
*.ckpt
*.onnx
checkpoints/
weights/

# Results / profiling artifacts -- keep small summary json/txt/md docs
# (benchmark numbers, profiler tables, findings writeups), exclude large
# binary trace dumps
results/*_trace.json
*.nsys-rep
*.qdrep
*.prof

# OS / editor
.DS_Store
.vscode/
.idea/

# Env files that may hold secrets (e.g. MAL API keys)
.env
*.env.local
