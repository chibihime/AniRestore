# MyAnimeList Official API v2 — only needed if fetch_cover_manifest.py has
# to backfill entries missing a cached image_url. Same client ID as
# AniOntology's .env can be reused (get one at https://myanimelist.net/apiconfig).
MAL_CLIENT_ID=your_mal_client_id_here
MAL_RPM=90

# Path to AniOntology's cached raw MAL dataset (used to derive the same
# anime IDs so both projects' cover-art datasets stay linked).
ANIONTOLOGY_RAW_JSON=../AniOntology/data/raw/myanimelist_anime.json
